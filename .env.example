# --- Viral AI Studio: lokale Konfiguration (.env.local) ---
# Alle Schlüssel sind optional. Ohne Schlüssel läuft der Basis-Modus (regelbasierte Texte,
# lokale Stimme, prozedurale Bilder). Schlüssel können auch in der App unter
# "Einstellungen" hinterlegt werden (verschlüsselt in der Datenbank).

# Datenhaltung: leer = eingebettetes PostgreSQL (PGlite) unter ./data/pg
# Produktion: postgres://user:pass@host:5432/viral
DATABASE_URL=
# Verzeichnis für Datenbank, Medien-Cache und fertige Videos
DATA_DIR=./data
# 32-Byte-Schlüssel (hex) zum Verschlüsseln gespeicherter API-Schlüssel.
# Leer = wird beim ersten Start erzeugt und in DATA_DIR/secret.key abgelegt.
APP_SECRET=

# LLM (Agenten): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Sprachausgabe: https://elevenlabs.io
ELEVENLABS_API_KEY=
# Google AI Studio (Veo-Videogenerierung, experimentell): https://aistudio.google.com
GEMINI_API_KEY=
# YouTube Data API v3 (Trenddaten): https://console.cloud.google.com
YOUTUBE_API_KEY=
